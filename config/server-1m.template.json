{
  "exe": "{{ENGINE}}",
  "cwd": "{{STRATA_SOURCE}}",
  "arch": "deepseek41",
  "model_name": "deepseek-orcarouter-mix256g-uncensored-experimental",
  "args": [
    "--pack",
    "{{PACK}}",
    "--max-context",
    "1048576",
    "--gpus",
    "0",
    "--cpu-threads",
    "16",
    "--reserve-mib",
    "6144",
    "--ssd-cache",
    "0",
    "--expert-profile",
    "{{PROFILE}}",
    "--mmap-experts",
    "off",
    "--dspark-block",
    "3",
    "--dspark-conf",
    "0.65",
    "--dspark",
    "on",
    "--prefill-chunk",
    "65280",
    "--experts",
    "6"
  ],
  "lib_dirs": [
    "{{CUDA_BIN}}"
  ],
  "tokenizer": "{{PACK}}/tokenizer",
  "env": {
    "STRATA_DS4_SLOT_KEEP": "0",
    "STRATA_DS4_AUTO_PIN": "0",
    "DS4_INDEX_NATIVE": "1",
    "DS4_INDEX_STATS": "1",
    "DS4_INDEX_ROWS": "128",
    "DS4_TOPK_MULTI": "1",
    "DS4_ATTN_ROWS": "4096",
    "DS4_ATTN_SPLIT": "1",
    "DS4_PREFILL_CHUNK_MAJOR_PHASE": "1",
    "DS4_LAYER_MAJOR": "0",
    "DS4_COPY_NUMA": "1",
    "DS4_FLOW": "1",
    "DS4_PREFILL_COLD_F16": "1",
    "DS4_PREFILL_COLD_F16_BUCKET": "128",
    "DS4_PREFILL_REGISTER_RAM_MB": "196608",
    "DS4_PREFILL_NORMALIZE_HEAT": "1",
    "DS4_PREFILL_FINAL_RESERVE_MB": "3072",
    "DS4_PREFILL_REGISTER_GPU_FLOOR_MB": "3072",
    "DS4_DECODE_FUSION": "1",
    "DS4_WARM": "0",
    "DS4_FLOW_STATS": "1",
    "DS4_PREFILL_ENGRAM_CACHE": "1",
    "DS4_QUERY_ROPE_SHARED": "1",
    "DS4_ATTN_G16_PAIRS": "1",
    "DS4_ROUTER_BATCH8": "1",
    "DS4_ATTN_G32_PAIRS": "1",
    "DS4_DQ_VECTOR_STORES": "1",
    "DS4_MOE_COMBINE_RANGE_ROWS": "1",
    "DS4_PREFILL_DENSE_PROJ_CACHE": "1",
    "DS4_RECORD_RAM_DOMAINS": "1",
    "DS4_CACHE_WORKER_EPOCH": "1",
    "DS4_PREFILL_REPEAT_REARM": "1",
    "STRATA_DS4_SLOT_GB": "0",
    "STRATA_OFFLINE": "1",
    "STRATA_DS4_SLOT_CAP": "0",
    "STRATA_DS4_SLOT_DIR": "{{SLOT_DIR}}",
    "STRATA_DS4_REUSE": "1",
    "CUDA_DEVICE_ORDER": "PCI_BUS_ID",
    "DS4_PREFILL_REPEAT_MIN_TOKENS": "32768",
    "DS4_GPU_MISSES": "1",
    "DS4_GPU_MISS_DIRECT": "1",
    "DS4_COPY_PIN": "0"
  },
  "engine_ready_s": 900,
  "host": "127.0.0.1",
  "port": 8080,
  "api_key": "{{API_KEY}}",
  "log": "{{LOG}}",
  "reasoning_budget_tokens": 32768,
  "experimental": true
}
